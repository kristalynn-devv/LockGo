# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง
# โปรเจกต์ที่ใช้: LockGo (ap-southeast-2) — Dashboard → Project Settings → API / Database
# Host: db.bjtepfrobpgywkaupowu.supabase.co · URL: https://bjtepfrobpgywkaupowu.supabase.co

# ── Client: apps/web (Vite) ───────────────────────────────────────
# หมายเหตุ: Vite อ่านเฉพาะตัวแปรที่ขึ้นต้นด้วย VITE_ เท่านั้น
# (ถ้าเคยตั้งเป็น NEXT_PUBLIC_* ไว้ ต้องเปลี่ยนชื่อ ไม่งั้น import.meta.env อ่านไม่เจอ)
VITE_SUPABASE_URL=https://bjtepfrobpgywkaupowu.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://localhost:3000
# URL ที่ Supabase จะ redirect กลับมาหลัง login สำเร็จ
# ต้องเพิ่ม URL นี้ใน Supabase → Authentication → URL Configuration → Redirect URLs ด้วย
VITE_AUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# ── Server: apps/api (NestJS) ─────────────────────────────────────
# ⚠️ ห้ามให้ค่าสามตัวนี้หลุดไปฝั่ง client เด็ดขาด
SUPABASE_URL=https://bjtepfrobpgywkaupowu.supabase.co
# Dashboard → Project Settings → API : service_role และ JWT Secret (ห้ามขึ้นต้น VITE_)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
PORT=3000

# ── Database (Drizzle migrations) ─────────────────────────────────
# Supabase Dashboard → Project Settings → Database → Connection string (URI)
# แทน [YOUR-PASSWORD] ด้วยรหัสผ่านฐานข้อมูลของโปรเจกต์
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.bjtepfrobpgywkaupowu.supabase.co:5432/postgres
